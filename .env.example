# Copy this file to .env for local development only.
# NEVER commit .env or paste production secrets into source control.
BOT_TOKEN=PASTE_NEW_BOT_TOKEN_HERE
OWNER_ID=PASTE_OWNER_TELEGRAM_USER_ID_HERE
ADMIN_ID=PASTE_ADMIN_TELEGRAM_USER_ID_HERE
YOUR_USERNAME=@your_telegram_username
UPDATES_CHANNEL=@your_updates_channel

DATA_DIR=./inf
UPLOAD_BOTS_DIR=./inf/upload_bots
DATABASE_PATH=./inf/bot_data.db
PENDING_ZIPS_DIR=./inf/pending_zips

FREE_USER_LIMIT=3
SUBSCRIBED_USER_LIMIT=15
ADMIN_LIMIT=999
OWNER_LIMIT=unlimited
PORT=10000
LOG_LEVEL=INFO

# HA / shared persistence
HA_ENABLED=0
INSTANCE_ID=hoster-4
MONGO_URI=PASTE_MONGODB_ATLAS_URI_HERE
DB_NAME=TG_HOSTER
LEASE_TTL_SECONDS=45
LEASE_POLL_SECONDS=5

# Dashboard API: use a random 32+ character secret.
DASHBOARD_API_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_32_CHARS_MINIMUM
# Comma-separated Vercel dashboard origins, e.g. https://tg-hoster.vercel.app
API_CORS_ORIGINS=https://YOUR-DASHBOARD.vercel.app

# Resource/upload limits
MAX_UPLOAD_MB=50
MAX_ZIP_UNCOMPRESSED_MB=200
MAX_ZIP_FILES=500
MAX_PROJECT_DISK_MB=250
MAX_LOG_MB=10
MAX_MEMORY_MB=1024
MAX_CPU_SECONDS=3600
MAX_OPEN_FILES=256
MAX_PROCESSES=64
DEP_INSTALL_TIMEOUT=300
SHARED_STATE_MAX_MB=200
AUTO_START_PROJECTS_ON_LEADER=1

# Distributed workers are optional. Keep disabled on the free hoster tier unless you have isolated workers.
WORKER_BRIDGE_ENABLED=0
TRUSTED_EXECUTION_ONLY=true
